import pygame
import random

pygame.init()

WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Ping Pong")
clock = pygame.time.Clock()

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

PADDLE_WIDTH = 18
PADDLE_HEIGHT = 110
PADDLE_SPEED = 7
NPC_SPEED = 6
BALL_SIZE = 16
BALL_SPEED = 5.5

left_x = 30
right_x = WIDTH - 30 - PADDLE_WIDTH
left_y = HEIGHT // 2 - PADDLE_HEIGHT // 2
right_y = HEIGHT // 2 - PADDLE_HEIGHT // 2

left_score = 0
right_score = 0

ball_x = WIDTH // 2 - BALL_SIZE // 2
ball_y = HEIGHT // 2 - BALL_SIZE // 2
ball_dx = random.choice([-1, 1]) * BALL_SPEED
ball_dy = random.choice([-1, 1]) * BALL_SPEED * 0.8

font = pygame.font.SysFont(None, 60)


def reset_ball():
    global ball_x, ball_y, ball_dx, ball_dy
    ball_x = WIDTH // 2 - BALL_SIZE // 2
    ball_y = HEIGHT // 2 - BALL_SIZE // 2
    ball_dx = random.choice([-1, 1]) * BALL_SPEED
    ball_dy = random.choice([-1, 1]) * BALL_SPEED * 0.8


running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    if keys[pygame.K_w] and left_y > 0:
        left_y -= PADDLE_SPEED
    if keys[pygame.K_s] and left_y + PADDLE_HEIGHT < HEIGHT:
        left_y += PADDLE_SPEED

    if right_y + PADDLE_HEIGHT / 2 < ball_y + BALL_SIZE / 2 and right_y + PADDLE_HEIGHT < HEIGHT:
        right_y += NPC_SPEED
    if right_y + PADDLE_HEIGHT / 2 > ball_y + BALL_SIZE / 2 and right_y > 0:
        right_y -= NPC_SPEED

    ball_x += ball_dx
    ball_y += ball_dy

    if ball_y <= 0:
        ball_y = 0
        ball_dy *= -1
    elif ball_y + BALL_SIZE >= HEIGHT:
        ball_y = HEIGHT - BALL_SIZE
        ball_dy *= -1

    if (
        left_x < ball_x + BALL_SIZE
        and ball_x < left_x + PADDLE_WIDTH
        and left_y < ball_y + BALL_SIZE
        and ball_y < left_y + PADDLE_HEIGHT
    ):
        ball_x = left_x + PADDLE_WIDTH
        ball_dx = abs(ball_dx)
        hit_position = (ball_y + BALL_SIZE / 2 - (left_y + PADDLE_HEIGHT / 2)) / (PADDLE_HEIGHT / 2)
        ball_dy = hit_position * 7

    if (
        right_x < ball_x + BALL_SIZE
        and ball_x < right_x + PADDLE_WIDTH
        and right_y < ball_y + BALL_SIZE
        and ball_y < right_y + PADDLE_HEIGHT
    ):
        ball_x = right_x - BALL_SIZE
        ball_dx = -abs(ball_dx)
        hit_position = (ball_y + BALL_SIZE / 2 - (right_y + PADDLE_HEIGHT / 2)) / (PADDLE_HEIGHT / 2)
        ball_dy = hit_position * 7

    if ball_x < 0:
        right_score += 1
        reset_ball()
    elif ball_x > WIDTH:
        left_score += 1
        reset_ball()

    screen.fill(BLACK)

    pygame.draw.rect(screen, WHITE, (left_x, left_y, PADDLE_WIDTH, PADDLE_HEIGHT))
    pygame.draw.rect(screen, WHITE, (right_x, right_y, PADDLE_WIDTH, PADDLE_HEIGHT))
    pygame.draw.ellipse(screen, WHITE, (ball_x, ball_y, BALL_SIZE, BALL_SIZE))
    pygame.draw.aaline(screen, WHITE, (WIDTH // 2, 0), (WIDTH // 2, HEIGHT))

    score_text = font.render(f"{left_score}   {right_score}", True, WHITE)
    screen.blit(score_text, (WIDTH // 2 - score_text.get_width() // 2, 20))

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
